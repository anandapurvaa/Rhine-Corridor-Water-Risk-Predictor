{
  "displayName": "Rhine training job failure",
  "documentation": {
    "content": "The gauge24h-train Cloud Run Job emitted a training_failed event. Check the Cloud Run Job execution logs, model training artifacts, and mlops.train_production logs.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Training failure count is greater than zero",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/rhine_training_failures\" resource.type=\"cloud_run_job\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "projects/rhine-corridor-navigator/notificationChannels/5841203484534699387"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "enabled": true
}