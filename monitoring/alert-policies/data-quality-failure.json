{
  "displayName": "Rhine monitoring data-quality failure",
  "documentation": {
    "content": "The monitoring watchdog detected one or more failed data-quality metrics. Check gauge24h-monitoring logs, mlops.data_quality_metrics, and the data_quality_checks stage.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "Monitoring data-quality failure count is greater than zero",
      "conditionThreshold": {
        "filter": "metric.type=\"logging.googleapis.com/user/rhine_monitoring_quality_failures\" resource.type=\"cloud_run_job\"",
        "comparison": "COMPARISON_GT",
        "thresholdValue": 0,
        "duration": "0s",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM"
          }
        ],
        "trigger": {
          "count": 1
        }
      }
    }
  ],
  "notificationChannels": [
    "projects/rhine-corridor-navigator/notificationChannels/5841203484534699387"
  ],
  "alertStrategy": {
    "autoClose": "86400s"
  },
  "enabled": true
}