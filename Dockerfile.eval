FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY modeling ./modeling
COPY config ./config
COPY ingestion ./ingestion
COPY mlops ./mlops
COPY sql ./sql
COPY bq_schemas ./bq_schemas

RUN python -m compileall modeling common ingestion mlops

ENV GAUGE24H_EVAL_SPLIT_NAME=production \
    PREDICTIONS_HISTORY_TABLE=gauge_24h_prediction_history \
    GAUGE24H_ACTUALS_TABLE=pegelonline_measurements_curated \
    GAUGE24H_ACTUAL_MATCH_TOLERANCE_MINUTES=30 \
    EVALUATIONS_TABLE=gauge_24h_prediction_evaluations \
    GAUGE24H_THRESHOLD_CONFIG_PATH=config/thresholds.yaml

CMD ["python", "-m", "modeling.evaluate_predictions_gauge_24h"]