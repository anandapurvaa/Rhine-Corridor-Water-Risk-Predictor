FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install --no-cache-dir -r requirements.txt

COPY api/ ./api/
COPY modeling/ ./modeling/
COPY config/ ./config/

ENV PYTHONPATH=/app \
    GCP_PROJECT_ID=rhine-corridor-navigator \
    GCP_REGION=europe-west3 \
    CURATED_DATASET=rhein_curated \
    MLOPS_DATASET=mlops \
    PREDICTIONS_TABLE=gauge_24h_production_predictions \
    PREDICTIONS_HISTORY_TABLE=gauge_24h_prediction_history \
    EVALUATIONS_TABLE=gauge_24h_prediction_evaluations \
    STATIONS_TABLE=dim_station \
    GAUGE24H_SEGMENTS_CONFIG_PATH=config/segments.yaml

RUN python -m compileall api modeling

EXPOSE 8080

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]